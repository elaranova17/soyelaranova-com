# Copiar a .env.local (no commitear secrets)

# Site
NEXT_PUBLIC_SITE_URL=https://soyelaranova.com

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=Elara Nova <hola@soyelaranova.com>
DISCOVERY_NOTIFY_TO=elaranova.17@gmail.com

# Sesión estratégica 25 CHF
# 1) Stripe Dashboard → Payment Links → crear producto "Sesión estratégica" 25 CHF
#    After completion → redirect a https://soyelaranova.com/sesion-estrategica/gracias
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_SESION=https://buy.stripe.com/xxxxx
# 2) Calendly → evento 20 min → copiar link público
NEXT_PUBLIC_CALENDLY_URL_SESION=https://calendly.com/tu-usuario/sesion-estrategica-20

# Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Hotmart · Ciclo Nova (cuando el checkout esté live)
NEXT_PUBLIC_HOTMART_CICLO_NOVA_URL=

# Supabase (si usás auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
